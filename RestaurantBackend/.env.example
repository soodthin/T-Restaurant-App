# Copy file nay thanh .env roi dien gia tri that vao
# cp .env.example .env

# Django
DJANGO_SECRET_KEY=thay-bang-secret-key-random
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# DB Clever Cloud (bat buoc set — khong con fallback local)
MYSQL_ADDON_HOST=xxx-mysql.services.clever-cloud.com
MYSQL_ADDON_DB=xxx
MYSQL_ADDON_USER=xxx
MYSQL_ADDON_PASSWORD=xxx
MYSQL_ADDON_PORT=3306

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Stripe (test mode) — lay tu dashboard.stripe.com/test/apikeys va /test/webhooks
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# MoMo (sandbox) — public test creds o doc developers.momo.vn (PARTNER_CODE=MOMO)
# hoac dang ky business.momo.vn de lay key prod
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=xxx
MOMO_SECRET_KEY=xxx
